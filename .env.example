# Next.js app (server unless NEXT_PUBLIC_). Copy to .env.local. Do not commit secrets.
# Content API: https://<region>.cdn.hygraph.com/content/<projectId>/<environment>

HYGRAPH_CONTENT_API_URL=
HYGRAPH_READ_TOKEN=
HYGRAPH_WEBHOOK_SECRET=

NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Script-only (`pnpm hygraph:*`). Not read by the Next.js app.

HYGRAPH_MANAGEMENT_API_URL=
HYGRAPH_MANAGEMENT_TOKEN=

# Documented names, not read. Locales are hardcoded in lib/locale.ts.
# HYGRAPH_PREVIEW_TOKEN is reserved for optional Draft preview (skipped).

HYGRAPH_PREVIEW_TOKEN=
DEFAULT_LOCALE=en_US
SUPPORTED_LOCALES=en_US,pt_BR,zh_CN
