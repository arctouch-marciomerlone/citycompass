# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.pnpm-store
jspm_packages/

# testing
/coverage
*.lcov
.nyc_output
/playwright-report
/test-results
/blob-report

# next.js
/.next/
/out/

# production
/build
/dist

# misc
.DS_Store
Thumbs.db
*.pem
*.swp
*.swo

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# caches
.eslintcache
.prettiercache
.stylelintcache
.cache
.turbo

# env files — keep the committed example
.env
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Hygraph schema backups from pnpm hygraph:backup / hygraph:reset
/hygraph/backups/

# local notes (not product docs)
talk.md

# IDE — keep shared .vscode recommendations
.idea/

# OS
*.local
